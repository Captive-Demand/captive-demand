# Server-only HubSpot Service Key. Next.js loads `.env.local`, not `env.local`.
HUBSPOT_ACCESS_TOKEN=

# Optional overrides — defaults match Captive Demand Audit Form in portal 51761572
# HUBSPOT_PORTAL_ID=51761572
# HUBSPOT_AUDIT_FORM_ID=b4944350-8188-42ab-b168-5fb8bf1eb967
# HUBSPOT_ADS_FORM_ID=da7205c5-9dda-44f1-beab-2c4ea26847eb

# Optional overrides — defaults live in siteConfig (src/lib/site.ts), so production
# needs neither of these set.
# NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-KDGH9S9
# NEXT_PUBLIC_HUBSPOT_MEETING_URL=https://meetings.hubspot.com/jordan1473

# Load GTM in `next dev` (off by default so local traffic stays out of reporting).
# NEXT_PUBLIC_GTM_IN_DEV=true
